# Copy to .env and fill in real values. Never commit .env.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=payshap-fraud-detection
MLFLOW_REGISTRY_MODEL_NAME=PayShap_Fraud_Detector
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# --- DVC remote storage (S3-compatible; swap for local dir in dev) ---
DVC_REMOTE_NAME=storage
DVC_REMOTE_URL=s3://payshap-ml-artifacts/dvc-store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1

# --- Database / feature store (if applicable) ---
DATABASE_URL=postgresql://user:password@localhost:5432/payshap_fraud
FEATURE_STORE_URI=

# --- PayShap / ISO 20022 upstream connectivity (sandbox only) ---
PAYSHAP_SANDBOX_BASE_URL=https://sandbox.payshap.example
PAYSHAP_CLIENT_ID=
PAYSHAP_CLIENT_SECRET=

# --- Serving app ---
APP_HOST=0.0.0.0
APP_PORT=8000
MODEL_STAGE=Staging
LOG_LEVEL=INFO

# --- Benchmark harness ---
BENCHMARK_TARGET_URL=http://localhost:8000/predict
