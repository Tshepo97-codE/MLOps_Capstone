cmd: venv/bin/python -m payshap_ml.pipelines.feature_engineering --params 
  params.yaml
deps:
- path: data/interim/cleaned.parquet
  hash: md5
  md5: 125aa8f61ab4651272bedd238dd1d8fa
  size: 1342183
- path: src/payshap_ml/pipelines/feature_engineering.py
  hash: md5
  md5: bc4522c7a562b8e81b75792ae7c7e83b
  size: 8528
params:
  params.yaml:
    base.seed: 42
    features:
      scaling_method: standard
      categorical_encoding: target
      velocity:
        windows_minutes:
        - 5
        - 15
        - 60
        - 1440
        max_lookback_days: 30
      time_delta:
        unit: seconds
      amount_ratio:
        historical_window_days: 90
        min_history_transactions: 3
      hourly_frequency:
        bucket_size_minutes: 60
      iso20022_fields:
      - clearing_system_property
      - proxy_type
      - debtor_agent_bic
      - creditor_agent_bic
      - purpose_code
      - charge_bearer
    split:
      method: time_based
      time_column: timestamp
outs:
- path: data/processed/test.parquet
  hash: md5
  md5: 62d75474902a3e04ca62530abdbebd8d
  size: 553094
- path: data/processed/train.parquet
  hash: md5
  md5: 8b93d06fef07e4ea9886033c2f3fda4e
  size: 1993202
